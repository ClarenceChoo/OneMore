# Create and sign into local accounts. Disable for an internet-facing deployment.
LOCAL_AUTH=true
POSTGRES_PASSWORD=replace_with_a_long_random_secret
# For deployed sign-in, set LOCAL_AUTH=false and configure the provider below.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
COOKIE_SECURE=false
# Public hostname for the optional HTTPS proxy in compose.prod.yaml.
DOMAIN=
